template <<END
        /* SINGLETON50-PROBE: quem pede o alocador (singleton, metodo, chave) */
        { static int _on=-1; if(_on<0){ extern char* getenv(const char*);
            const char* _e=getenv("PS3_TRACE_SING50"); _on=(_e&&*_e&&*_e!='0')?1:0; }
          static int _cap=-1; if(_cap<0){ extern char* getenv(const char*);
            const char* _c=getenv("PS3_TRACE_SING50_CAP"); _cap=(_c&&*_c)?atoi(_c):5000; }
          if(_on){ static uint32_t _pc=0xFFFFFFFFu, _pr=0xFFFFFFFFu; static int _n=0;
            uint32_t _code=(uint32_t)ctx->gpr[0], _r4=(uint32_t)ctx->gpr[4];
            if((_code!=_pc || _r4!=_pr) && (_cap<0 || _n++<_cap)){ _pc=_code; _pr=_r4;
              fprintf(stderr,"[SING50] #%d sing=0x%08X vt=0x%08X opd=0x%08X code=0x%08X key=0x%08X obj24=0x%08X\n",
                _n, (uint32_t)ctx->gpr[3], (uint32_t)ctx->gpr[11],
                (uint32_t)ctx->gpr[9], _code, _r4, (uint32_t)ctx->gpr[10]);
              fflush(stderr); } } }
END
