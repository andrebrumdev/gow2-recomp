        /* ALLOCSRC-PROBE: qual alocador veio, e se tem tabela de pools */
        { static int _on=-1; if(_on<0){ extern char* getenv(const char*);
            const char* _e=getenv("PS3_TRACE_ALLOCSRC"); _on=(_e&&*_e&&*_e!='0')?1:0; }
          static int _cap=-1; if(_cap<0){ extern char* getenv(const char*);
            const char* _c=getenv("PS3_TRACE_ALLOCSRC_CAP"); _cap=(_c&&*_c)?atoi(_c):5000; }
          if(_on){ uint32_t _a=(uint32_t)ctx->gpr[3];
            static uint32_t _prev=0xFFFFFFFFu; static int _n=0;
            if(_a!=_prev && (_cap<0 || _n++<_cap)){ _prev=_a;
              fprintf(stderr,"[ALLOCSRC] #%d alloc=0x%08X vt=0x%08X tab8C[0]=0x%08X\n",
                _n, _a, (_a>=0x10000u&&_a<0x50000000u)?vm_read32(_a):0u,
                (_a>=0x10000u&&_a<0x50000000u)?vm_read32(_a+0x8Cu):0u);
              fflush(stderr); } } }
END
