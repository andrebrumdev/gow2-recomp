template <<END
        /* SZCLASS-PROBE: alocador, indice de classe, slot e o que sai */
        { static int _on=-1; if(_on<0){ extern char* getenv(const char*);
            const char* _e=getenv("PS3_TRACE_SZCLASS"); _on=(_e&&*_e&&*_e!='0')?1:0; }
          static int _cap=-1; if(_cap<0){ extern char* getenv(const char*);
            const char* _c=getenv("PS3_TRACE_SZCLASS_CAP"); _cap=(_c&&*_c)?atoi(_c):60; }
          if(_on){ static int _n=0; if(_cap<0 || _n++<_cap){
            uint32_t _slot=(uint32_t)ctx->gpr[3];
            int _mau=(_slot!=0u)&&(_slot<0x10000u||_slot>=0x50000000u);
            fprintf(stderr,"[SZCLASS] #%d alloc=0x%08X idx=%d ea=0x%08X slot=0x%08X%s\n",
              _n, (uint32_t)ctx->gpr[29], (int)(int32_t)ctx->gpr[31],
              (uint32_t)(ctx->gpr[9]+0xCu), _slot,
              _mau?"  <SLOT-MAU>":((_slot==0u)?"  <SLOT-ZERO>":""));
            fflush(stderr); } } }
END
