template <<END
        /* TOCCHAIN-2182A4-PROBE: os quatro degraus da cadeia do TOC ate' ao obj.
         * Ver docs/re_sessions/2026-08-05-E19-o-descritor-vem-do-TOC.md */
        { static int _on=-1; if(_on<0){ extern char* getenv(const char*);
            const char* _e=getenv("PS3_TRACE_TOCCHAIN"); _on=(_e&&*_e&&*_e!='0')?1:0; }
          static int _cap=-1; if(_cap<0){ extern char* getenv(const char*);
            const char* _c=getenv("PS3_TRACE_TOCCHAIN_CAP"); _cap=(_c&&*_c)?atoi(_c):200; }
          if(_on){ static int _n=0; if(_cap<0 || _n++<_cap){
            uint32_t _A=vm_read32((uint32_t)ctx->gpr[2] - 0x2B18u);   /* relido */
            uint32_t _B=(uint32_t)ctx->gpr[3];                        /* o obj */
            uint32_t _C=(uint32_t)ctx->gpr[10];
            uint32_t _D=(uint32_t)ctx->gpr[11];
            fprintf(stderr,"[TOCCHAIN] #%d A=0x%08X B=0x%08X%s C=0x%08X D=0x%08X r29=0x%08X\n",
              _n, _A, _B, (_B==0x400C6C68u)?" <B-MAU>":"", _C, _D,
              (uint32_t)ctx->gpr[29]);
            fflush(stderr); } } }
END
