template <<END
        /* LAZYINIT-212ED0-PROBE: gestor, flag de init e o slot +0xD0 lido aqui.
         * Ver docs/re_sessions/2026-08-05-E30-sintese-e-o-que-resolver.md */
        { static int _on=-1; if(_on<0){ extern char* getenv(const char*);
            const char* _e=getenv("PS3_TRACE_LAZYINIT"); _on=(_e&&*_e&&*_e!='0')?1:0; }
          static int _cap=-1; if(_cap<0){ extern char* getenv(const char*);
            const char* _c=getenv("PS3_TRACE_LAZYINIT_CAP"); _cap=(_c&&*_c)?atoi(_c):400; }
          if(_on){ static int _n=0; if(_cap<0 || _n++<_cap){
            uint32_t _m=(uint32_t)ctx->gpr[31];
            uint32_t _f=(uint32_t)ctx->gpr[0];
            uint32_t _p0=vm_read32(_m + 0xD0u);
            fprintf(stderr,"[LAZYINIT] #%d mgr=0x%08X flag=0x%08X pool0=0x%08X init_vai_correr=%d%s\n",
              _n, _m, _f, _p0, (_f==0u)?1:0,
              (_p0==0u)?" <POOL0-NULO>":"");
            fflush(stderr); } } }
END
