# Copy to local.env (untracked) and fill in.
GOW2_IOS_TEAM=XXXXXXXXXX                        # personal team id (Xcode > Settings > Accounts)
GOW2_IOS_DEVICE=00000000-0000000000000000       # xcrun devicectl list devices
GOW2_WORK=/path/to/gow2-recomp                  # lift, SPU images, game data
# GOW2_IOS_BUNDLE_ID=com.<team-lowercase>.gow2recomp
# GOW2_IOS_LIFT=/path/to/gow2-recomp/recomp_macos_e435
# GOW2_IOS_BUILD=/path/to/gow2-recomp/build-ios
# PS3_ENGINE_ROOT=/path/to/ps3recomp             # default: ../ps3recomp next to GOW2_WORK
